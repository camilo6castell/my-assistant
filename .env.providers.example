# ============================================
# .env.providers
# ============================================
# IMPORTANT: this file goes in .gitignore. Never commit real API keys.
# Use a secret manager (or at minimum a local .env.providers outside git)
# in any environment that is not your own machine.

# --- BACKENDS -- Runtime URLs ---
# A backend = a concrete runtime. Here only HOW to connect to each one
# is specified (URL + credential). WHICH model from that backend each
# pipeline role uses is decided below (EMBEDDER / LLM_ROL_*), never here.

LLM_FLM_URL=http://127.0.0.1:52625/v1
LLM_OLLAMA_URL=http://127.0.0.1:11434
LLM_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=DUMMY_KEY

EMBEDDER_FLM_URL=http://127.0.0.1:52625/v1
EMBEDDER_OLLAMA_URL=http://127.0.0.1:11434

# --- EMBEDDER -- backend + model that generates embeddings ---
# Format "backend,model". Valid backends: sentence_transformers
# (in-process, no URL) | ollama | flm.
#
# IMPORTANT: changing backend or model invalidates existing indexes.
# Indexes are stored in paths separated by backend/model:
#   /srv/ai/vector_stores/<backend>/<model_safe>/<category>/<collection>/
#
# Adding a new model to an existing backend = an entry in
# src/config/models/<backend>.py. A new environment variable is never needed.

EMBEDDER=ollama,bge-m3

# --- LLM BY ROLE -- backend + model that handles each pipeline role ---
# Format "backend,model", same as EMBEDDER. Each pipeline role
# (see LLMRole in src/nlp/llm/roles.py) is resolved here, separately,
# to a concrete backend + model -- this is the ONLY place where we
# decide "which model does what".
#
# LLM_ROL_GENERATE:     writes the final response the user sees
#   (/query, /demo/query, CLI). Example with a local model: indexed
#   documents never leave your machine.
# LLM_ROL_SUPPLEMENT:   decides whether a web search adds genuinely
#   new information to an already-generated response.
#
# Adding a new model to an existing backend = an entry in
# src/config/models/<backend>.py. Adding a new backend (e.g. Claude,
# OpenAI) = modifying src/nlp/llm/providers.py + a new file in
# src/config/models/. Neither case touches this file except to point
# the role at the new backend/model.

LLM_ROL_GENERATE=flm,qwen3.5:9b
LLM_ROL_SUPPLEMENT=flm,qwen3.5:9b
