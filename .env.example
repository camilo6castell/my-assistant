# ============================================
# Copy this file to .env and .env.providers separately -- each
# section indicates which file it belongs to. Both are in
# .gitignore; this template is the only file that is committed.
# ============================================

# ============================================
# .env
# ============================================

# --- AI_HOME ---
# Root directory for all application data (logs, vector stores, ingest
# files). Defaults to ~/ragsody if not set.
# AI_HOME=/srv/ai

# --- INGEST ---

CHUNK_SIZE=500
CHUNK_OVERLAP=100

MAX_PAGES=50
DELAY=1

# --- LLM ---

LLM_TIMEOUT=600
# Opt-in diagnostics: dumps each LLM request to ./debug_last_llm_request.json
# (ready to reproduce with curl -d @debug_last_llm_request.json). Leave as
# false unless you are debugging something specific.
LLM_DEBUG_DUMP=false

# --- QUERY ---

HARD_TOP_K_INITIAL=15
HARD_TOP_K_FINAL=5
SOFT_TOP_K_INITIAL=25
SOFT_TOP_K_FINAL=7

MAX_TURNS=4

# --- CONTEXT GUARD ---

CONTEXT_GUARD_SAFETY_MARGIN=0.10
CONTEXT_GUARD_OUTPUT_RESERVE=1024

# --- EMBEDDINGS ---

EMBEDDING_BATCH_SIZE=64

# --- MCP SERVER ---
# MCP_BEARER_TOKEN: shared secret between MCP client (frontend) and server.
# Empty = no auth (not recommended in tailnet with multiple devices).
# The MCP server listens on MCP_HOST:MCP_PORT for Streamable HTTP transport.
# MCP_ALLOWED_HOSTS: comma-separated list of allowed Host header values for
# DNS rebinding protection (empty = accept all).
# IMPORTANT: If deploying via Tailscale Funnel, leave MCP_HOST=127.0.0.1 so
# the MCP server is NOT exposed to the internet. Only the API server
# (API_HOST=0.0.0.0) needs to be reachable via Funnel.
MCP_BEARER_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORT=8100
MCP_ALLOWED_HOSTS=

# --- DEMO ENDPOINT (POST /api/v1/demo/query) ---
# DEMO_MAX_CONCURRENCY: max concurrent requests to the streaming demo
# endpoint. Default 1 (single-threaded on the LLM backend). Increase if
# the backend GPU/NPU handles concurrent inference efficiently.
# DEMO_MAX_TOKENS: max_tokens override for the demo endpoint. Leave empty
# to use the model's default (currently 4096 for all configured models).
# Set higher (e.g. 8192) if the use case needs longer responses, or lower
# (e.g. 1024) to reduce latency on the streaming endpoint.

DEMO_MAX_CONCURRENCY=1
DEMO_MAX_TOKENS=

# --- API SERVER ---
# API_HOST and API_PORT for the FastAPI REST server.
# When using Tailscale Funnel to expose the demo endpoint publicly:
#   Set API_HOST=0.0.0.0 (or the tailscale IP) so Funnel can reach it.
#   Keep MCP_HOST=127.0.0.1 (see MCP section above) so the MCP server
#   stays local and is not accessible from the internet.
# API_HOST=127.0.0.1
# API_PORT=8000

# --- WEB SEARCH (Tavily) ---
# Global kill-switch: when False, the /query endpoint returns 400 if the
# client requests web_search=True, regardless of the API key. Set to True
# only after obtaining a free API key from https://tavily.com.

WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_DEPTH=basic
WEB_SEARCH_INCLUDE_ANSWER=false

# ============================================
# DEBUG
# ============================================

LLM_DEBUG_DUMP=false
