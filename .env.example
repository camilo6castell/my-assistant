# ============================================
# Copy this file to .env and .env.providers separately -- each
# section indicates which file it belongs to. Both are in
# .gitignore; this template is the only file that is committed.
# ============================================

# ============================================
# .env
# ============================================

# --- AI_HOME ---

AI_HOME=/srv/ai

# --- INGEST ---

CHUNK_SIZE=500
CHUNK_OVERLAP=100

MAX_PAGES=50
DELAY=1

# --- LLM ---

LLM_TIMEOUT=600
# Opt-in diagnostics: dumps each LLM request to ./debug_last_llm_request.json
# (ready to reproduce with curl -d @debug_last_llm_request.json). Leave as
# false unless you are debugging something specific.
LLM_DEBUG_DUMP=false

# --- QUERY ---

HARD_TOP_K_INITIAL=15
HARD_TOP_K_FINAL=5
SOFT_TOP_K_INITIAL=25
SOFT_TOP_K_FINAL=7

MAX_TURNS=4

# --- AGENT - LangGraph ---

CONFIDENCE_LIMIT=0.55
MAX_REVIEW_ATTEMPTS=1

# --- CONTEXT GUARD ---

CONTEXT_GUARD_SAFETY_MARGIN=0.10
CONTEXT_GUARD_OUTPUT_RESERVE=1024

# --- EMBEDDINGS ---

EMBEDDING_BATCH_SIZE=64

# --- MCP SERVER ---
# MCP_BEARER_TOKEN: shared secret between MCP client (frontend) and server.
# Empty = no auth (not recommended in tailnet with multiple devices).
# The MCP server listens on MCP_HOST:MCP_PORT for Streamable HTTP transport.
# MCP_ALLOWED_HOSTS: comma-separated list of allowed Host header values for
# DNS rebinding protection (empty = accept all).
# IMPORTANT: If deploying via Tailscale Funnel, leave MCP_HOST=127.0.0.1 so
# the MCP server is NOT exposed to the internet. Only the API server
# (API_HOST=0.0.0.0) needs to be reachable via Funnel.
MCP_BEARER_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORT=8100
MCP_ALLOWED_HOSTS=

# --- DEMO ENDPOINT (POST /api/v1/demo/query) ---
# DEMO_MAX_CONCURRENCY: max concurrent requests to the streaming demo
# endpoint. Default 1 (single-threaded on the LLM backend). Increase if
# the backend GPU/NPU handles concurrent inference efficiently.
# DEMO_MAX_TOKENS: max_tokens override for the demo endpoint. Leave empty
# to use the model's default (currently 4096 for all configured models).
# Set higher (e.g. 8192) if the use case needs longer responses, or lower
# (e.g. 1024) to reduce latency on the streaming endpoint.
DEMO_MAX_CONCURRENCY=1
DEMO_MAX_TOKENS=

# --- API SERVER ---
# API_HOST and API_PORT for the FastAPI REST server.
# When using Tailscale Funnel to expose the demo endpoint publicly:
#   Set API_HOST=0.0.0.0 (or the tailscale IP) so Funnel can reach it.
#   Keep MCP_HOST=127.0.0.1 (see MCP section above) so the MCP server
#   stays local and is not accessible from the internet.
# API_HOST=127.0.0.1
# API_PORT=8000

# --- WEB SEARCH (Tavily) ---
# Global kill-switch: when False, the /query endpoint returns 400 if the
# client requests web_search=True, regardless of the API key. Set to True
# only after obtaining a free API key from https://tavily.com.
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_DEPTH=basic
WEB_SEARCH_INCLUDE_ANSWER=false


# ============================================
# .env.providers
# ============================================
# IMPORTANT: this file goes in .gitignore. Never commit real API keys.
# Use a secret manager (or at minimum a local .env.providers outside git)
# in any environment that is not your own machine.

# --- BACKENDS -- Runtime URLs ---
# A backend = a concrete runtime. Here only HOW to connect to each one
# is specified (URL + credential). WHICH model from that backend each
# pipeline role uses is decided below (EMBEDDER / LLM_ROL_*), never here.

LLM_FLM_URL=http://127.0.0.1:52625/v1
LLM_OLLAMA_URL=http://127.0.0.1:11434
LLM_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=DUMMY_KEY

EMBEDDER_FLM_URL=http://127.0.0.1:52625/v1
EMBEDDER_OLLAMA_URL=http://127.0.0.1:11434

# --- EMBEDDER -- backend + model that generates embeddings ---
# Format "backend,model". Valid backends: sentence_transformers
# (in-process, no URL) | ollama | flm.
#
# IMPORTANT: changing backend or model invalidates existing indexes.
# Indexes are stored in paths separated by backend/model:
#   /srv/ai/vector_stores/<backend>/<model_safe>/<category>/<collection>/
#
# Adding a new model to an existing backend = an entry in
# src/config/models/<backend>.py. A new environment variable is never needed.

EMBEDDER=ollama,bge-m3

# --- LLM BY ROLE -- backend + model that handles each pipeline role ---
# Format "backend,model", same as EMBEDDER. Each pipeline role
# (see LLMRole in src/nlp/llm/roles.py) is resolved here, separately,
# to a concrete backend + model -- this is the ONLY place where we
# decide "which model does what".
#
# LLM_ROL_GENERATE:    writes the final response the user sees
#   (generate_node/correct_node in the graph, /query, and the CLI
#   direct chat). Example with a local model: indexed documents never
#   leave your machine.
# LLM_ROL_REFORMULATE: rewrites the user's question to improve
#   retrieval when initial confidence is low. Short task, benefits
#   from a fast model.
# LLM_ROL_REVIEW:      evaluates whether the generated response passes
#   quality control (grounding, source attribution) before delivery.
# LLM_ROL_SUPPLEMENT:  decides whether a web search adds genuinely new
#   information to an already-generated response.
#
# Adding a new model to an existing backend = an entry in
# src/config/models/<backend>.py. Adding a new backend (e.g. Claude,
# OpenAI) = modifying src/nlp/llm/providers.py + a new file in
# src/config/models/. Neither case touches this file except to point
# the role at the new backend/model.

LLM_ROL_GENERATE=flm,qwen3.5:9b
LLM_ROL_REFORMULATE=ollama,qwen3.5:2b
LLM_ROL_REVIEW=gemini,gemini-2.5-flash-lite
LLM_ROL_SUPPLEMENT=flm,qwen3.5:9b
