# ============================================
# .env vars
# ============================================

# AI_HOME

AI_HOME=/srv/ai

# INGEST

CHUNK_SIZE=500
CHUNK_OVERLAP=100

MAX_PAGES=50
DELAY=1

# LLM

LLM_TEMPERATURE=0.2
LLM_TIMEOUT=600

# QUERY

HARD_TOP_K_INITIAL=15
HARD_TOP_K_FINAL=5
SOFT_TOP_K_INITIAL=25
SOFT_TOP_K_FINAL=7

MAX_TURNS=4

# AGENT - LangGraph

CONFIDENCE_LIMIT=0.55

# ============================================
# WEB SEARCH (Tavily)
# ============================================
# Kill-switch global: en False, el endpoint /query devuelve 400 si el
# cliente pide web_search=True, sin importar la API key. Ponelo en True
# solo después de conseguir una API key gratis en https://tavily.com.
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_MAX_RESULTS=5


# ============================================
# MULTI-PROVIDER LLM
# ============================================
# Cada proveedor se configura por separado. El nodo del grafo que lo usa
# se decide con REFORMULATE_PROVIDER / GENERATE_PROVIDER, no aquí.
#
# IMPORTANTE: este archivo va en .gitignore. Nunca commitear API keys
# reales. Usa un secret manager (o como mínimo .env local fuera de git)
# en cualquier entorno que no sea tu máquina.

# --- local (FastFlowLM / Ollama / cualquier runtime OpenAI-compatible) ---
LOCAL_BASE_URL=http://127.0.0.1:52625/v1
LOCAL_API_KEY=ollama
LOCAL_MODEL=qwen3:8b
# Qué implementación de cliente usar -- "openai_compat" para cualquier
# servidor que hable /v1/chat/completions (FastFlowLM, la mayoría de
# runtimes), "ollama_native" para el paquete oficial `ollama` (necesario
# si querés controlar el modo de razonamiento de forma confiable en
# Ollama -- su endpoint OpenAI-compatible tiene soporte inconsistente
# para eso). Ver src/llm/backends/.
LOCAL_CLIENT=openai_compat
# Qué archivo de src/config/models/ mirar para las capacidades reales de
# LOCAL_MODEL (temperature, max_tokens, modo de razonamiento y cómo
# activarlo). Ahí es tipado, no acá -- agregar un modelo nuevo es una
# entrada en ese archivo, no una variable de entorno nueva.
LOCAL_CAPABILITIES=fastflowlm

# --- gemini (endpoint OpenAI-compatible de Google) ---
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=DUMMY_KEY
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_CLIENT=openai_compat
GEMINI_CAPABILITIES=gemini

# ============================================
# ROUTING — qué proveedor usa cada nodo del grafo
# ============================================
# reformulate_node -> gemini: rápido y barato, tarea corta (reescribir 1 query)
# generate_node     -> local: la respuesta final usa SIEMPRE el modelo local
#                      (dato sensible / RAG sobre tus propios documentos
#                      nunca sale de tu máquina)
REFORMULATE_PROVIDER=gemini
GENERATE_PROVIDER=local

# ============================================
# EMBEDDING BACKEND
# ============================================
# Elige el runtime que genera los embeddings:
#
#   sentence_transformers  — modelo HuggingFace en proceso Python (CPU/GPU torch)
#   ollama                 — Ollama local con soporte Vulkan (GPU AMD)
#   fastflowlm             — FastFlowLM con soporte NPU
#
# EMBEDDING_MODEL sobreescribe EMBED_MODEL solo para backends HTTP.
# Para sentence_transformers, usa EMBED_MODEL en .env.
#
# IMPORTANTE: cambiar backend o modelo invalida los índices existentes.
# Los índices se guardan en rutas separadas por backend/modelo:
#   /srv/ai/vector_stores/<backend>/<model_safe>/<categoria>/<coleccion>/
# donde model_safe reemplaza '/' y ':' por '_'.
#
# Ejemplos de configuración:

# --- sentence_transformers (default, sin servidor externo) ---
#EMBEDDING_BACKEND=sentence_transformers
# EMBED_MODEL=BAAI/bge-m3

# --- ollama (GPU Vulkan) ---
 EMBEDDING_BACKEND=ollama
 EMBEDDING_BASE_URL=http://127.0.0.1:11434
 EMBEDDING_API_KEY=ollama
 EMBEDDING_MODEL=bge-m3

# --- fastflowlm (NPU) ---
# EMBEDDING_BACKEND=fastflowlm
# EMBEDDING_BASE_URL=http://127.0.0.1:52625
# EMBEDDING_API_KEY=flm
# EMBEDDING_MODEL=xxx

# --- Web search Tavily ---
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE