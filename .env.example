# ============================================
# Copiá este archivo a .env y a .env.providers por separado -- cada
# sección de acá indica a cuál de los dos pertenece. Ambos están en
# .gitignore; este template es lo único que sí se commitea.
# ============================================

# ============================================
# .env
# ============================================

# --- AI_HOME ---

AI_HOME=/srv/ai

# --- INGEST ---

CHUNK_SIZE=500
CHUNK_OVERLAP=100

MAX_PAGES=50
DELAY=1

# --- LLM ---

LLM_TIMEOUT=600
# Diagnóstico opt-in: vuelca cada request al LLM a ./debug_last_llm_request.json
# (listo para reproducir con curl -d @debug_last_llm_request.json). Dejar en
# false salvo que estés debuggeando algo puntual.
LLM_DEBUG_DUMP=false

# --- QUERY ---

HARD_TOP_K_INITIAL=15
HARD_TOP_K_FINAL=5
SOFT_TOP_K_INITIAL=25
SOFT_TOP_K_FINAL=7

MAX_TURNS=4

# --- AGENT - LangGraph ---

CONFIDENCE_LIMIT=0.55

# --- WEB SEARCH (Tavily) ---
# Kill-switch global: en False, el endpoint /query devuelve 400 si el
# cliente pide web_search=True, sin importar la API key. Ponelo en True
# solo después de conseguir una API key gratis en https://tavily.com.
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_MAX_RESULTS=5


# ============================================
# .env.providers
# ============================================
# IMPORTANTE: este archivo va en .gitignore. Nunca commitear API keys
# reales. Usa un secret manager (o como mínimo .env.providers local
# fuera de git) en cualquier entorno que no sea tu máquina.

# --- BACKENDS -- URLs de runtime ---
# Un backend = un runtime concreto. Acá solo se dice CÓMO conectarse a
# cada uno. QUÉ modelo de cada backend usa el embedder o cada rol del
# pipeline se decide más abajo (EMBEDDER / LLM_ROL_*), nunca acá.

LLM_FLM_URL=http://127.0.0.1:52625/v1
LLM_OLLAMA_URL=http://127.0.0.1:11434
LLM_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=DUMMY_KEY

EMBEDDER_FLM_URL=http://127.0.0.1:52625/v1
EMBEDDER_OLLAMA_URL=http://127.0.0.1:11434

# --- EMBEDDER -- backend + modelo que generan los embeddings ---
# Formato "backend,modelo". Backends válidos: sentence_transformers
# (en proceso, sin URL) | ollama | flm.
#
# IMPORTANTE: cambiar backend o modelo invalida los índices existentes.
# Los índices se guardan en rutas separadas por backend/modelo:
#   /srv/ai/vector_stores/<backend>/<model_safe>/<categoria>/<coleccion>/
#
# Agregar un modelo nuevo a un backend existente = una entrada en
# src/config/models/<backend>.py. Nunca hace falta una variable de
# entorno nueva para eso.

EMBEDDER=ollama,bge-m3

# --- LLM POR ROL -- backend + modelo que atiende cada rol del pipeline ---
# Formato "backend,modelo", igual que EMBEDDER. Cada rol del pipeline
# (ver LLMRole en src/nlp/llm/roles.py) se resuelve acá, por separado,
# a un backend + modelo concretos -- este es el ÚNICO lugar donde se
# decide "qué modelo hace qué".
#
# LLM_ROL_GENERATE:    escribe la respuesta final que ve el usuario
#   (generate_node/correct_node del grafo, /query, y el chat directo
#   del CLI). Ejemplo con un modelo local: los documentos indexados
#   nunca salen de tu máquina.
# LLM_ROL_REFORMULATE: reescribe la pregunta del usuario para mejorar
#   el retrieval cuando la confidence inicial es baja. Tarea corta, se
#   beneficia de un modelo rápido.
# LLM_ROL_REVIEW:      evalúa si la respuesta generada pasa control de
#   calidad (grounding, atribución de fuentes) antes de entregarla.
# LLM_ROL_SUPPLEMENT:  decide si una búsqueda web le agrega algo
#   genuinamente nuevo a una respuesta ya generada.
#
# Agregar un modelo nuevo a un backend existente = una entrada en
# src/config/models/<backend>.py. Agregar un backend nuevo (ej. Claude,
# OpenAI) = tocar src/nlp/llm/providers.py + un archivo nuevo en
# src/config/models/. Ninguno de los dos casos toca este archivo salvo
# para apuntar el rol al backend/modelo nuevo.

LLM_ROL_GENERATE=flm,qwen3.5:9b
LLM_ROL_REFORMULATE=ollama,qwen3.5:2b
LLM_ROL_REVIEW=gemini,gemini-2.5-flash-lite
LLM_ROL_SUPPLEMENT=flm,qwen3.5:9b
