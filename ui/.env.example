VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Demo mode -- see src/lib/demo.ts. Set to true for a static deployment
# with no backend (e.g. Vercel); leave false for local dev against the
# real backend above.
VITE_DEMO_MODE=false

# Only read when VITE_DEMO_MODE=true -- called directly from the browser.
# Ends up in the public JS bundle: use a key scoped/rate-limited for this,
# never the same key as the real backend's GEMINI_API_KEY.
VITE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash-lite
